# Owly English — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# DashScope / Qwen LLM API (optional — app works offline without this)
VITE_OWLY_LLM_API_KEY=your-api-key-here
VITE_OWLY_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VITE_OWLY_LLM_MODEL=qwen3.8-max
